# ============================================================
# nfhandshake 配置示例
# ============================================================
# 用法：复制本文件为 nfhandshake.properties，填入真实值。
#
# 放置位置（二选一）：
#   <游戏目录>/config/nfhandshake.properties   （推荐）
#   <游戏目录>/nfhandshake.properties
#
# 【重要】填好后请勿提交到版本库 —— 本文件含密码。
# 修改后重启游戏生效，无需重新构建 mod。
# ============================================================

# ---------- 连接设置 ----------
# 服务器地址，格式 域名:端口
# 留空表示不自动连接（此时只能手动在游戏里点"多人游戏"进入）
serverAddress=

# 启动游戏后是否自动连接上面的 serverAddress
autoconnect=false

# ---------- 自动化操作 ----------
# 进入服务器后要自动执行的命令（不要带前导斜杠）
# 例如：server xxx  表示进服后自动执行 /server xxx
# 留空表示不执行任何命令
subServerCommand=

# 是否在收到"请输入 /login"这类提示时自动发送登录命令
# 需要同时填写下面的 password
autologin=false

# 登录密码（切勿提交到版本库）
password=

# ---------- 握手行为（一般不需要改） ----------
# 配置阶段回哪个协议段
#   4 = CONFIGURATION（正确值）
#   1 = PLAY（错误值，会导致协商失败被服务器拒绝）
configProto=4

# PLAY 阶段回哪个协议段（1 = PLAY）
playProto=1

# 对照实验用：只声明前 N 个通道
#   -1 = 全部通道（正常运行值）
channelLimit=-1

# ---------- 通道表（一般不需要配置） ----------
# 本 mod 会自动探测服务器的通道清单：
#   服务器在握手时主动下发它拥有的全部通道，我们照抄回去即可。
# 因此通常无需手工维护通道表。
#
# 仅以下情况才需要外部通道表：
#   1. 想离线预置通道内容
#   2. 做对照实验
# 外部通道表放在同目录下的 nfhandshake-channels.json
