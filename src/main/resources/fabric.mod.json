{
	"schemaVersion": 1,
	"id": "nfhandshake",
	"version": "${version}",
	"name": "ViaNeoForge",
	"description": "让 Fabric 客户端经 ViaFabricPlus 通过 NeoForge 服务端握手协商：自动探测通道清单、补齐配置阶段全部请求应答、注册表同步四层容错。协议层研究项目。",
	"authors": ["fabneo"],
	"license": "MIT",
	"environment": "client",
	"entrypoints": {
		"client": ["net.fabneo.nfhandshake.NfHandshakeClient"]
	},
	"mixins": [
		{
			"config": "nfhandshake.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~1.21.11",
		"java": ">=21",
		"fabric-api": "*"
	}
}
